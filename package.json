{
  "name": "webchess",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "model:export": "${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender} -b --factory-startup -P blender/build_pieces.py",
    "model:compress": "npx --yes @gltf-transform/cli@4.5.1 meshopt blender/build/chess.glb public/models/chess.glb",
    "model": "npm run model:export && npm run model:compress"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "chess.js": "^1.4.0",
    "stockfish": "19.0.1",
    "three": "^0.186.1"
  },
  "description": "Ajedrez 3D en el navegador contra Claude o Stockfish: elfos contra orcos",
  "engines": {
    "node": ">=22"
  }
}
